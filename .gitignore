## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# Node.js
node_modules/
npm-debug.log
.npm

# Development
.vscode/
.idea/
*.swp
*.swo
*~

# Build results
[Dd]ebug/
[Rr]elease/
dist/
build/
.cache/

# IDE
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Logs
*.log
*.logs

# OS
.DS_Store
Thumbs.db